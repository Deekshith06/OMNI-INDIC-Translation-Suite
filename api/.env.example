# ==============================================================================
# Omni-Indic Translation Suite — Environment Configuration
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run the API without loading any ML models (for UI testing).
# Set to "false" for full inference. Requires sufficient RAM (see RAM section).
DEMO_MODE=false

# ── Translation model ─────────────────────────────────────────────────────────
# Recommended: ai4bharat/indictrans2-en-indic-dist-200M (820 MB INT8, 1.6 GB FP32)
# Fallback:    facebook/nllb-200-distilled-600M         (1.9 GB INT8, 3.8 GB FP32)
TRANSLATION_MODEL=ai4bharat/indictrans2-en-indic-dist-200M

# ── Quantization ──────────────────────────────────────────────────────────────
# "int8"  — Enable INT8 dynamic quantization (recommended for CPU, saves ~50% RAM)
# "fp32"  — Full precision (better quality, more RAM)
QUANTIZE=int8

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# Use * only for development; restrict in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Hugging Face cache ────────────────────────────────────────────────────────
# Override where model weights are cached.
# Default: ~/.cache/huggingface
# HF_HOME=/mnt/models/.cache/huggingface

# ── Offline mode ──────────────────────────────────────────────────────────────
# Set to "1" to prevent transformers from making network calls.
# Requires model weights to already be cached (or baked into Docker image).
# TRANSFORMERS_OFFLINE=1

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
